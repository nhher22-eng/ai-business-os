APP_ENV=production
APP_NAME=AI Business OS
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://aios:change-me@postgres:5432/aios
REDIS_URL=redis://redis:6379/0
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE
POSTGRES_DB=aios
POSTGRES_USER=aios
POSTGRES_PASSWORD=change-me
WORKER_POLL_SECONDS=1
SCHEDULER_INTERVAL_SECONDS=10

# M-05 / M-06 content studio
MEDIA_ROOT=/app/data
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_PREVIEW_QUALITY=low
IMAGE_FINAL_QUALITY=high
IMAGE_REQUEST_TIMEOUT_SECONDS=180

IMAGE_MAX_PREVIEW_GENERATIONS=8
IMAGE_MAX_FINAL_GENERATIONS=3
# Configure estimates from your actual provider/account pricing if desired.
IMAGE_PREVIEW_ESTIMATED_COST_MICROS=0
IMAGE_FINAL_ESTIMATED_COST_MICROS=0
